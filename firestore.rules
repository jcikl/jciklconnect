rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function getUserRole() {
      return exists(/databases/$(database)/documents/members/$(request.auth.uid)) ? 
             get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role : 
             null;
    }
    
    function isMember() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/members/$(request.auth.uid)) &&
             getUserRole() != null &&
             getUserRole() in ['GUEST', 'MEMBER', 'BOARD', 'ADMIN', 'SUPER_ADMIN'];
    }

    // isActiveMember: MEMBER and above — excludes GUEST (self-registered, not yet vetted)
    function isActiveMember() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/members/$(request.auth.uid)) &&
             getUserRole() != null &&
             getUserRole() in ['MEMBER', 'BOARD', 'ADMIN', 'SUPER_ADMIN'];
    }
    
    function memberData() {
      return get(/databases/$(database)/documents/members/$(request.auth.uid)).data;
    }

    function memberJciCareer() {
      return memberData().get('jciCareer', {});
    }

    // Synced from boardMembers when assigned to the current calendar-year board.
    // Supports both legacy top-level fields and the canonical jciCareer.* fields.
    // The flags only count for KL roles: an external (AFFILIATE / CHAPTER_ADMIN) or INACTIVE doc
    // carrying isCurrentBoardMember never gets board / finance / member-editing access.
    // (Feeds isBoard, canReadOrgMembers, canEditMembers, canAccessFinance, isFinanceOperator.)
    function isCurrentBoardMember() {
      return exists(/databases/$(database)/documents/members/$(request.auth.uid)) &&
             !(getUserRole() in ['AFFILIATE', 'CHAPTER_ADMIN', 'INACTIVE']) &&
             (memberData().get('isCurrentBoardMember', false) == true ||
              memberJciCareer().get('isCurrentBoardMember', false) == true);
    }

    function currentBoardPosition() {
      return memberData().get('currentBoardPosition', memberJciCareer().get('currentBoardPosition', ''));
    }

    // isBoard() intentionally includes ADMIN as a superset of BOARD for Firestore collection access.
    // Note: usePermissions.ts board-elevation block explicitly excludes ADMIN (ADMIN gets permissions from
    // ROLE_PERMISSIONS[ADMIN] directly, not from the board elevation path). These are intentionally different.
    // Honorary and Senator membershipType members are assigned role=BOARD via roleForMembershipType().
    // They therefore pass isBoard() checks and can access board-level collections as designed.
    function isBoard() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/members/$(request.auth.uid)) &&
             (
               (getUserRole() != null && getUserRole() in ['BOARD', 'ADMIN', 'SUPER_ADMIN']) ||
               isCurrentBoardMember()
             );
    }
    
    function isAdmin() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/members/$(request.auth.uid)) &&
             getUserRole() != null &&
             getUserRole() in ['ADMIN', 'SUPER_ADMIN'];
    }

    function isDeveloper() {
      return isAuthenticated() && (
        request.auth.token.get('developer', false) == true ||
        request.auth.token.get('isDeveloper', false) == true ||
        (
          exists(/databases/$(database)/documents/members/$(request.auth.uid)) &&
          memberData().get('isDeveloper', false) == true
        ) ||
        getUserRole() == 'SUPER_ADMIN'
      );
    }
    
    // Roles that can read members at org/LO level (board members and admins)
    function canReadOrgMembers() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/members/$(request.auth.uid)) &&
             (
               (getUserRole() != null &&
                getUserRole() in ['ADMIN', 'BOARD', 'SUPER_ADMIN']) ||
               isCurrentBoardMember()
             );
    }

    // Roles that can edit members
    function canEditMembers() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/members/$(request.auth.uid)) &&
             (
               (getUserRole() != null &&
                getUserRole() in ['ADMIN', 'BOARD', 'SUPER_ADMIN']) ||
               isCurrentBoardMember()
             );
    }
    
    function getMyLoId() {
      return exists(/databases/$(database)/documents/members/$(request.auth.uid)) ? 
             get(/databases/$(database)/documents/members/$(request.auth.uid)).data.get('loId', null) : null;
    }
    
    // Same LO or legacy doc (no loId) for org-level readers
    function resourceInMyLo(resourceData) {
      let myLo = getMyLoId();
      return myLo != null && (resourceData.get('loId', null) == myLo || resourceData.get('loId', null) == null);
    }

    // ── External members (JCI members of OTHER chapters) ───────────────────────────────
    // AFFILIATE / CHAPTER_ADMIN are deliberately NOT in isMember() / isActiveMember() /
    // canReadOrgMembers() / isBoard() / isAdmin(), so every role-gated rule already excludes them.
    // Rules that only checked isAuthenticated() now use isInternalUser() unless the module is on
    // the external whitelist (events, projects, event registrations, surveys targeted to them,
    // hobby clubs, member benefits, partners/ads, sister chapters, memberCards).

    // KL's own chapter id (config/constants.ts DEFAULT_LO_ID). External users can never belong to it.
    function klLoId() {
      return 'jcikl';
    }

    function isAffiliate() {
      return isAuthenticated() && getUserRole() == 'AFFILIATE';
    }

    function isChapterAdmin() {
      return isAuthenticated() && getUserRole() == 'CHAPTER_ADMIN';
    }

    function isExternal() {
      return isAuthenticated() && getUserRole() in ['AFFILIATE', 'CHAPTER_ADMIN'];
    }

    // External user whose affiliation is active and whose loId is a real non-KL chapter.
    // pending_* / suspended / expired external users get only their own docs.
    function isActiveExternal() {
      return isExternal() &&
             memberData().get('affiliation', {}).get('status', '') == 'active' &&
             getMyLoId() is string &&
             getMyLoId() != klLoId();
    }

    function isActiveChapterAdmin() {
      return isChapterAdmin() && isActiveExternal();
    }

    // Any signed-in user who is NOT an external member: KL members of every role, GUEST, INACTIVE
    // and users whose member doc does not exist yet (sign-up). Same audience as the old isAuthenticated().
    function isInternalUser() {
      return isAuthenticated() && !isExternal();
    }

    // CHAPTER_ADMIN may read full member docs of their own chapter only. Written against
    // resource.data.loId (no .get) so list queries constrained with where('loId','==',myLoId) are provable.
    // A KL member doc for non-admin KL readers (get only): loId 'jcikl' or missing, and not an external role.
    function isKlMemberDoc(data) {
      return data.get('loId', klLoId()) == klLoId() &&
             !(data.get('role', '') in ['AFFILIATE', 'CHAPTER_ADMIN']);
    }

    // L2: a doc with an external role must sit in a non-KL chapter (checked on every create/update).
    function externalRoleHasChapter() {
      return !(request.resource.data.get('role', '') in ['AFFILIATE', 'CHAPTER_ADMIN']) ||
             request.resource.data.get('loId', klLoId()) != klLoId();
    }

    // M2: an external user's own event registration / cancellation on an event doc: only
    // registeredMembers gains or loses exactly their uid and attendees moves by exactly ±1
    // (what eventRegistrationService / eventsService write via arrayUnion/arrayRemove + increment).
    function isOwnRegistrationCounterChange() {
      let before = resource.data.get('registeredMembers', []);
      let after = request.resource.data.get('registeredMembers', []);
      let delta = request.resource.data.get('attendees', 0) - resource.data.get('attendees', 0);
      let uid = request.auth.uid;
      return request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['attendees', 'registeredMembers', 'updatedAt']) &&
             ((!(uid in before) && (uid in after) && after.size() == before.size() + 1 &&
               after.toSet().difference(before.toSet()).hasOnly([uid]) &&
               before.toSet().difference(after.toSet()).size() == 0 && delta == 1) ||
              ((uid in before) && !(uid in after) && after.size() == before.size() - 1 &&
               before.toSet().difference(after.toSet()).hasOnly([uid]) &&
               after.toSet().difference(before.toSet()).size() == 0 && delta == -1));
    }

    function chapterAdminCanRead() {
      return isActiveChapterAdmin() && resource.data.loId == getMyLoId();
    }

    // Users collection (FCM tokens)
    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Members collection: 组织财政/活动财政/会员 boundary; multi-LO: read by same loId or self.
    match /members/{memberId} {
      // 1. Basic Read Access (Get and List)
      // Public business profiles are served from the businessDirectory subcollection — not here.
      // External users (AFFILIATE / CHAPTER_ADMIN): own doc only (by uid, not by email match);
      // an active CHAPTER_ADMIN additionally reads docs of their own chapter (chapterAdminCanRead).
      // Non-admin KL readers (isActiveMember / canReadOrgMembers): KL docs only — a doc without loId
      // counts as KL; external members' full docs are admin-only (others use memberCards).
      allow get: if isAuthenticated() && (
        request.auth.uid == memberId ||
        (!isExternal() && resource != null && resource.data.get('email', '') == request.auth.token.get('email', '')) ||
        isAdmin() ||
        ((isActiveMember() || canReadOrgMembers()) && isKlMemberDoc(resource.data)) ||
        chapterAdminCanRead()
      );

      // Allow listing for email search during linking only (business directory uses businessDirectory subcollection)
      // SEC: exclude GUEST — isMember() includes GUEST, which would let any self-registered
      // GUEST dump the full member roster (NRIC, DOB, phone). Use isActiveMember() instead.
      // Non-admin KL readers: the query itself must carry where('loId', '==', 'jcikl') (Firestore proves
      // the condition from the query's filters). Docs without a loId field are then not returned
      // to non-admins; admins list everything unfiltered.
      allow list: if isAuthenticated() && (
        isAdmin() ||
        ((isActiveMember() || canReadOrgMembers()) && resource.data.loId == klLoId()) ||
        // Own-email lookup (account linking), kept from the former `allow get, read` rule.
        (!isExternal() && resource.data.email == request.auth.token.email) ||
        (request.query.filters.get('email', []) == [request.auth.token.get('email', '')]) ||
        (request.query.filters.email == [request.auth.token.get('email', '')]) ||
        // CHAPTER_ADMIN: the query itself must carry where('loId', '==', <own chapter id>).
        chapterAdminCanRead()
      );

      // 2. Create/Update/Delete Access
      // Self-registration (GUEST): only new users (doc must not already exist) may self-create
      // with a GUEST-role doc and a strict field whitelist. This prevents existing MEMBER/INACTIVE
      // users from overwriting their own doc to reset their role.
      // Board/Admin-created members: isBoard() bypass allows all fields (including bulk import).
      // Bulk import (ADMIN+ in UI) is additionally restricted at the service/function layer since
      // Firestore rules cannot distinguish a single write from a batch loop.
      // name/email may live at top-level (legacy) OR inside general.name/contact.email (current nested format).
      // isBoard() bypasses field-shape checks; self-registration still validates both layouts.
      allow create: if isAuthenticated() &&
                       request.resource.data.role is string &&
                       externalRoleHasChapter() &&
                       // Only KL admins create external members (AFFILIATE / CHAPTER_ADMIN). Non-admin
                       // creators (BOARD, self sign-up) create KL docs only: loId 'jcikl' (or absent → KL)
                       // and no affiliation.
                       (isAdmin() ||
                        (!(request.resource.data.role in ['AFFILIATE', 'CHAPTER_ADMIN']) &&
                         request.resource.data.get('loId', klLoId()) == klLoId() &&
                         !request.resource.data.keys().hasAny(['affiliation']))) &&
                       (isBoard() ||
                        (request.auth.uid == memberId &&
                         !exists(/databases/$(database)/documents/members/$(memberId)) &&
                         request.resource.data.get('role', 'GUEST') == 'GUEST' &&
                         request.resource.data.keys().hasOnly([
                           'email', 'name', 'displayName', 'photoURL', 'photoUrl',
                           'createdAt', 'role', 'status', 'loId',
                           'general', 'contact', 'membership',
                           // R-028: fields the sign-up form writes (hooks/useAuth.tsx signUp)
                           'others', 'skills', 'surveyAnswers', 'personaType', 'tendencyTags',
                           'tier', 'points', 'churnRisk', 'attendanceRate', 'duesStatus', 'badges', 'jciCareer'
                         ]) &&
                         // System-managed fields may only carry the sign-up defaults, and jciCareer may only
                         // hold joinDate, so a self-registered GUEST cannot grant itself points, badges or a
                         // board position (isCurrentBoardMember / currentBoardPosition drive isBoard()).
                         request.resource.data.get('tier', 'Bronze') == 'Bronze' &&
                         request.resource.data.get('points', 0) == 0 &&
                         request.resource.data.get('churnRisk', 'Low') == 'Low' &&
                         request.resource.data.get('attendanceRate', 100) == 100 &&
                         request.resource.data.get('duesStatus', 'Pending') == 'Pending' &&
                         request.resource.data.get('badges', []).size() == 0 &&
                         request.resource.data.get('jciCareer', {}).keys().hasOnly(['joinDate']) &&
                         (request.resource.data.name is string ||
                          request.resource.data.get('general', {}).get('name', null) is string) &&
                         (request.resource.data.email is string ||
                          request.resource.data.get('contact', {}).get('email', null) is string)));

      // Self-write: members may update any profile field EXCEPT the locked list below.
      // INACTIVE users are blocked from self-write at the rules layer (not just service layer).
      // GUEST may also set nationality/dob/idNumber; once promoted to MEMBER+ those three are locked.
      // BOARD+ edits: senatorshipId is immutable once board-validated; only Admin can override (E2 fix).
      allow update: if isAuthenticated() && externalRoleHasChapter() && (
        (request.auth.uid == memberId &&
         resource.data.get('role', 'GUEST') != 'INACTIVE' &&
         // E8 fix: self-write cannot delete name/email. R-028: accept either the legacy top-level fields
         // or the current nested general.name / contact.email.
         (request.resource.data.get('name', null) is string ||
          request.resource.data.get('general', {}).get('name', null) is string) &&
         (request.resource.data.get('email', null) is string ||
          request.resource.data.get('contact', {}).get('email', null) is string) &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny([
           'role', 'loId', 'membership', 'membershipType',
           'senatorCertified', 'senatorshipBoardValidated', 'senatorshipId',
           'senatorshipValidatedAt', 'senatorshipValidatedBy',
           'jciCareer', 'menteeIds', 'mentorId',
           'deletedAt', 'deletedBy', 'createdAt', 'createdBy',
           'attendanceCheckins', 'attendanceMonths', 'attendanceYear',
           'leaderboardScore', 'points',
           'churnRisk', 'tier', 'birthdayMMDD', 'isDeveloper',
           'isCurrentBoardMember', 'currentBoardPosition',
           // External members cannot self-activate or change their category/country.
           'affiliation'
         ]) &&
         (resource.data.get('role', 'GUEST') == 'GUEST' ||
          (request.resource.data.get('general', {}).get('nationality', null) == resource.data.get('general', {}).get('nationality', null) &&
           request.resource.data.get('general', {}).get('dob', null)         == resource.data.get('general', {}).get('dob', null) &&
           request.resource.data.get('general', {}).get('idNumber', null)    == resource.data.get('general', {}).get('idNumber', null) &&
           request.resource.data.get('general', {}).get('idType', null)      == resource.data.get('general', {}).get('idType', null)))
        ) ||
        (canEditMembers() && (resource == null || isAdmin() || resourceInMyLo(resource.data)) &&
         // BOARD members cannot elevate anyone to ADMIN / SUPER_ADMIN (E13 fix)
         // ...nor to CHAPTER_ADMIN (chapter admins are created by KL admins only).
         // ...nor to an external role, nor move a doc between chapters or touch affiliation (M3).
         (isAdmin() ||
          (!(request.resource.data.get('role', resource.data.get('role', '')) in ['ADMIN', 'SUPER_ADMIN', 'AFFILIATE', 'CHAPTER_ADMIN']) &&
           !request.resource.data.diff(resource.data).affectedKeys().hasAny(['loId', 'affiliation']))) &&
         (isAdmin() ||
          !resource.data.get('senatorshipBoardValidated', false) ||
          request.resource.data.get('senatorshipId', resource.data.get('senatorshipId', null))
            == resource.data.get('senatorshipId', null))
        ) ||
        // Active CHAPTER_ADMIN → AFFILIATE docs of their own chapter: only affiliation.status and its
        // audit fields. role / loId / everything else unchanged; may never set status 'active'
        // (KL admins activate). Never touches KL members (own loId is never 'jcikl').
        (isActiveChapterAdmin() &&
         resource.data.loId == getMyLoId() &&
         resource.data.get('role', '') == 'AFFILIATE' &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['affiliation', 'updatedAt', 'updatedBy']) &&
         request.resource.data.get('affiliation', {}).diff(resource.data.get('affiliation', {})).affectedKeys()
           .hasOnly(['status', 'chapterApprovedAt', 'chapterApprovedBy', 'statusUpdatedAt', 'statusUpdatedBy']) &&
         (request.resource.data.get('affiliation', {}).get('status', '') == resource.data.get('affiliation', {}).get('status', '') ||
          request.resource.data.get('affiliation', {}).get('status', '') in ['pending_chapter', 'pending_kl', 'suspended', 'expired']) &&
         // L6: audit fields, when written, must name the caller.
         (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['updatedBy']) ||
          request.resource.data.updatedBy == request.auth.uid) &&
         (!request.resource.data.get('affiliation', {}).diff(resource.data.get('affiliation', {})).affectedKeys().hasAny(['chapterApprovedBy']) ||
          request.resource.data.affiliation.chapterApprovedBy == request.auth.uid) &&
         (!request.resource.data.get('affiliation', {}).diff(resource.data.get('affiliation', {})).affectedKeys().hasAny(['statusUpdatedBy']) ||
          request.resource.data.affiliation.statusUpdatedBy == request.auth.uid))
      );

      // Only admins may delete; self-delete removed to prevent orphan data (E07)
      // R-034: SUPER_ADMIN is org-wide and may have no loId, so it skips the LO check.
      allow delete: if isAdmin() && (getUserRole() == 'SUPER_ADMIN' || resourceInMyLo(resource.data));
    }

    // Member public cards (types/member.ts MemberCard): directory-safe fields only, doc id = member id.
    // The only member data external users can read about other people.
    // - KL active members / org readers: read all cards.
    // - Active external users: cards with international == true OR loId == their own chapter.
    //   List queries must carry where('international','==',true) or where('loId','==',<own chapter>).
    // - Writes: the member themself (MEMBER+ or active external) or KL editors; exact key set;
    //   loId and international must mirror the member doc (getAfter → works inside a batch that
    //   updates the member doc in the same commit). Missing member doc → write denied (no orphans).
    function memberCardKeys() {
      return ['displayName', 'avatarUrl', 'loId', 'country', 'companyName', 'position', 'department',
              'industry', 'businessCategory', 'companyDescription', 'website',
              'acceptInternationalBusiness', 'specialOfferSummary', 'international', 'updatedAt'];
    }

    function validMemberCard(memberId) {
      let card = request.resource.data;
      let owner = getAfter(/databases/$(database)/documents/members/$(memberId)).data;
      return card.keys().hasOnly(memberCardKeys()) &&
             card.keys().hasAll(['displayName', 'loId', 'international', 'updatedAt']) &&
             card.displayName is string &&
             card.loId is string &&
             card.international is bool &&
             card.loId == owner.get('loId', klLoId()) &&
             card.international == owner.get('privacy', {}).get('shareCardInternationally', false);
    }

    // Reciprocity (owner rule): a non-admin may view other people's cards only after opting in
    // their OWN card (members.privacy.shareCardInternationally == true). Reuses memberData(), the
    // caller's member doc that getUserRole() etc. already read (one billed get per request).
    function hasOptedInCard() {
      return memberData().get('privacy', {}).get('shareCardInternationally', false) == true;
    }

    function externalCanReadCard() {
      return isActiveExternal() &&
             (resource.data.international == true || resource.data.loId == getMyLoId());
    }

    match /memberCards/{memberId} {
      // Owner may always get their own card; KL admins read everything; everyone else (KL members,
      // BOARD, active externals — even for their own chapter) must have opted in first.
      allow get: if isAuthenticated() && (
        request.auth.uid == memberId ||
        isAdmin() ||
        (hasOptedInCard() && (isActiveMember() || canReadOrgMembers() || externalCanReadCard()))
      );
      allow list: if isAuthenticated() && (
        isAdmin() ||
        (hasOptedInCard() && (isActiveMember() || canReadOrgMembers() || externalCanReadCard()))
      );
      allow create, update: if isAuthenticated() &&
        ((request.auth.uid == memberId && (isActiveMember() || isActiveExternal())) ||
         canEditMembers()) &&
        validMemberCard(memberId);
      allow delete: if isAuthenticated() && (request.auth.uid == memberId || canEditMembers());
    }

    // Communication/Posts collection
    match /communication/{postId} {
      // Allow read: authenticated users (including those without member doc yet)
      allow read: if isInternalUser();
      
      // Allow create: active members only (MEMBER+); GUEST excluded; require author attribution.
      // authorId must equal the caller's uid so update/delete rules (which read resource.data.authorId)
      // are guaranteed to work even if the post was created by bypassing the service layer.
      allow create: if isActiveMember() &&
                       request.resource.data.keys().hasAll(['author', 'content', 'createdAt']) &&
                       request.resource.data.author.id == request.auth.uid &&
                       request.resource.data.authorId == request.auth.uid;
      
      // Allow update: post author (checked via flat authorId field written at create time) or BOARD+.
      // Uses resource.data.authorId (existing doc) — NOT request.resource.data — so an attacker
      // cannot forge ownership by supplying a different authorId in the update payload.
      allow update: if isAuthenticated() &&
                       (resource.data.authorId == request.auth.uid || isBoard() || isAdmin());

      // Allow delete: post author or BOARD+
      allow delete: if isAuthenticated() &&
                       (resource.data.authorId == request.auth.uid || isBoard() || isAdmin());
    }
    
    // Events collection
    match /events/{eventId} {
      // FIX 2: split read so public events page returns results.
      // resource.data is null during list queries, so any resource.data condition on allow read
      // would silently block all list results. allow list: if true lets unauthenticated visitors
      // see the public events page; the service layer where() clause filters by status.
      allow get: if isInternalUser() || isActiveExternal();
      allow list: if true;
      // FIX 1: restrict writes to Board+; members may update only their own attendance fields
      // P1 Fix: require critical fields on create to prevent partial/malformed event documents
      allow create: if (isBoard() || isAdmin()) &&
                       request.resource.data.keys().hasAll(['title', 'status', 'createdAt']);
      allow delete: if isBoard() || isAdmin();
      // KL members: pre-existing field-only check (unchanged). Active external users: only their own
      // uid in/out of registeredMembers with attendees ±1 (M2).
      allow update: if isBoard() || isAdmin() ||
                       (isMember() &&
                        request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['attendees', 'registeredMembers', 'updatedAt'])) ||
                       (isActiveExternal() && isOwnRegistrationCounterChange());
    }

    // Projects collection
    match /projects/{projectId} {
      // Public events page uses getDocs(query(projects, where('status','==','Active'))).
      // Firestore list rules can't filter by query params, so allow list: if true lets the
      // unauthenticated guest events page work; service layer filters status in code.
      allow get: if isInternalUser() || isActiveExternal() || resource.data.status == 'Active';
      allow list: if true;
      // FIX 1: restrict writes to Board+; members may update only their own attendance/registration fields
      // P1 Fix: require critical fields on create to prevent partial/malformed project documents
      allow create: if (isBoard() || isAdmin()) &&
                       request.resource.data.keys().hasAll(['title', 'status', 'createdAt']);
      allow delete: if isBoard() || isAdmin();
      // Events are stored here (eventRegistrationService / eventsService write doc(PROJECTS, eventId)),
      // so active external users register through the same tight own-uid ±1 check as /events (M2).
      allow update: if isBoard() || isAdmin() ||
                       (isMember() &&
                        request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['attendees', 'registeredMembers', 'updatedAt'])) ||
                       (isActiveExternal() && isOwnRegistrationCounterChange());
    }

    // Flagship Projects collection
    match /flagship_projects/{projectId} {
      allow read: if true;
      allow create, update, delete: if isBoard() || isAdmin();
    }

    // Project tasks collection (Kanban, Gantt)
    match /tasks/{taskId} {
      // FIX 12: any authenticated user (including GUEST) was previously able to create and delete tasks
      // FIX 21: restrict create to Board/Admin — members should not create tasks on arbitrary projects
      allow read: if isMember();
      allow create: if isBoard() || isAdmin();
      // Assignee can update their own task (e.g. mark complete); board/admin unrestricted
      // P1 FIX: service writes field as 'assignee'; rules now check all three field names for compatibility
      allow update: if isBoard() || isAdmin() ||
                       (isAuthenticated() && resource.data.get('assignee', resource.data.get('assigneeId', resource.data.get('assignedTo', ''))) == request.auth.uid);
      allow delete: if isBoard() || isAdmin();
    }
    
    function isFinanceOperatorPosition(position) {
      return position.matches('.*[Tt]reasurer.*') ||
             position.matches('.*[Ss]ecretary.*') ||
             (position.matches('.*[Pp]resident.*') &&
              !position.matches('.*[Vv]ice.*'));
    }

    // Finance operators: current board Treasurer, Secretary, or President.
    function isFinanceOperator() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/members/$(request.auth.uid)) &&
             isCurrentBoardMember() &&
             isFinanceOperatorPosition(currentBoardPosition());
    }

    // Finance access: current-calendar-year board members and admins
    function canAccessFinance() {
      return isBoard();
    }

    // Deletion is destructive and irreversible — reserved for admins and board finance operators.
    function canDeleteFinance() {
      return isAdmin() || isFinanceOperator();
    }

    // PERF-001: finance/meta stores a summary of available transaction years (arrayUnion in createTransaction).
    // Any authenticated user can read (year list is non-sensitive); only finance roles can write.
    match /finance/{docId} {
      allow read: if isInternalUser();
      allow write: if isAdmin() || isFinanceOperator();
    }

    // Transactions: board / finance roles; multi-LO scoped by loId unless isAdmin/Board()
    match /transactions/{transactionId} {
      // TX-R1: split read into get (resource.data valid) and list (resource.data is null — no loId check)
      allow get: if isAuthenticated() &&
        (isAdmin() ||
         isBoard() ||
         (canAccessFinance() && (resource == null || resource.data.get('loId', null) == null || resource.data.get('loId', null) == getMyLoId())));
      allow list: if isAuthenticated() && (isAdmin() || isBoard());
      // E8 fix: on CREATE resource is null; must use request.resource.data not resource.data
      // P1 Fix: require critical fields on create to prevent partial/malformed transaction documents
      allow create: if (isAdmin() || isFinanceOperator()) &&
        request.resource.data.keys().hasAll(['amount', 'type', 'date', 'bankAccountId']) &&
        (request.resource.data.get('status', '') != 'Reconciled' &&
         request.resource.data.get('status', '') != 'Partially Reconciled' &&
         request.resource.data.get('status', '') != 'Voided');
      // TX-R2: finance staff limited to business fields on unlocked transactions.
      // R-028: 'reconciliation' (nested match data written by matching) and the void fields added to the whitelist.
      allow update: if (isAdmin() || isFinanceOperator()) &&
        (
        (resource == null ||
          (resource.data.get('status', '') != 'Reconciled' &&
           resource.data.get('status', '') != 'Partially Reconciled' &&
           resource.data.get('status', '') != 'Voided')) &&
         // E1 fix: added 'memberId', 'loId', 'transactionType', 'year' to Board-level hasOnly
         request.resource.data.diff(resource.data).affectedKeys().hasOnly([
           'status', 'reconciliationId', 'reconciledAt', 'reconciledBy',
           'prevStatus', 'paidAt', 'paidBy', 'updatedAt', 'updatedBy', 'notes', 'category',
           'isSplit', 'splitIds', 'originalCategory', 'projectId', 'purpose', 'projectTransactionIds',
           'projectTransactionId',
           'description', 'amount', 'type', 'date', 'reference', 'bankAccountId', 'attachments',
           'paymentRequestId', 'inventoryLinkId', 'inventoryVariant', 'inventoryQuantity', 'tags',
           'matchStatus', 'matchedBankTxIds',
           'memberId', 'loId', 'transactionType', 'year',
           'reconciliation', 'voidedAt', 'voidedBy', 'voidReason'
         ]));
      // R-028 unlock: finance roles may take a Reconciled / Partially Reconciled transaction back out of
      // reconciliation (unmatch, delete reconciliation, compensation). Only reconciliation fields may
      // change, and the result may not be Voided; amount, date and other business fields stay locked.
      allow update: if (isAdmin() || isFinanceOperator()) &&
        resource.data.get('status', '') in ['Reconciled', 'Partially Reconciled'] &&
        request.resource.data.get('status', '') != 'Voided' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'reconciliation', 'reconciliationId', 'prevStatus', 'reconciledAt', 'reconciledBy',
          'matchStatus', 'matchedBankTxIds', 'paymentRequestId', 'updatedAt', 'updatedBy'
        ]);
      // R-028 void of a reconciled transaction: Admin only (finance operators unmatch first).
      allow update: if isAdmin() &&
        resource.data.get('status', '') in ['Reconciled', 'Partially Reconciled'] &&
        request.resource.data.get('status', '') == 'Voided' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'voidedAt', 'voidedBy', 'voidReason', 'reconciliation', 'updatedAt', 'updatedBy'
        ]);
      // PT-match: board members can link/unlink project entries without full finance operator rights
      allow update: if (isBoard() || isAdmin()) &&
        resource.data.get('status', '') != 'Reconciled' &&
        resource.data.get('status', '') != 'Voided' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'projectTransactionId', 'purpose', 'updatedAt', 'updatedBy'
        ]);
      allow delete: if canDeleteFinance() &&
        resource.data.get('status', '') != 'Reconciled' &&
        resource.data.get('status', '') != 'Partially Reconciled' &&
        resource.data.get('status', '') != 'Cleared' &&
        resource.data.get('status', '') != 'Voided';
    }

    // Transaction Splits: same rules as transactions; update/delete blocked on Reconciled parent
    match /transactionSplits/{splitId} {
      // E1 fix (P0): TransactionSplit docs have no loId field so the old loId check was always true,
      // exposing cross-LO splits to any finance user. Replaced with isBoard()/isAdmin() only.
      // Cross-LO isolation at split level requires a data migration to add loId — out of scope here.
      allow read: if isAuthenticated() && (isAdmin() || isBoard());
      // T7: block adding splits to already-reconciled parent transactions
      allow create: if (isAdmin() || isFinanceOperator()) &&
        get(/databases/$(database)/documents/transactions/$(request.resource.data.get('parentTransactionId', ''))).data.get('status', '') != 'Reconciled';
      allow update: if (isAdmin() || isFinanceOperator()) &&
        (!exists(/databases/$(database)/documents/transactions/$(resource.data.parentTransactionId)) ||
         (get(/databases/$(database)/documents/transactions/$(resource.data.parentTransactionId)).data.get('status', '') != 'Reconciled' &&
          get(/databases/$(database)/documents/transactions/$(resource.data.parentTransactionId)).data.get('status', '') != 'Partially Reconciled' &&
          get(/databases/$(database)/documents/transactions/$(resource.data.parentTransactionId)).data.get('status', '') != 'Voided')) &&
        (isAdmin() ||
         // E7 fix: removed 'type' from non-admin hasOnly — users must not change split type directly
         request.resource.data.diff(resource.data).affectedKeys().hasOnly([
           'description', 'amount', 'category', 'projectId', 'year', 'memberId',
           'purpose', 'paymentRequestId', 'notes', 'updatedAt', 'updatedBy',
           'status', 'reconciledAt', 'reconciledBy', 'projectTransactionId', 'projectTransactionIds',
           'inventoryLinkId', 'inventoryVariant', 'inventoryQuantity', 'prevStatus'
         ]));
      allow delete: if canDeleteFinance() &&
        (!exists(/databases/$(database)/documents/transactions/$(resource.data.parentTransactionId)) ||
         (get(/databases/$(database)/documents/transactions/$(resource.data.parentTransactionId)).data.get('status', '') != 'Reconciled' &&
          get(/databases/$(database)/documents/transactions/$(resource.data.parentTransactionId)).data.get('status', '') != 'Partially Reconciled' &&
          get(/databases/$(database)/documents/transactions/$(resource.data.parentTransactionId)).data.get('status', '') != 'Voided'));
    }

    // Project Transactions (Story 4.1): Project-specific financials.
    // These carry the same reconciliation reverse-index (matchedBankAmount etc.) as
    // `transactions`, so they get the same finance-role gate — not just isAuthenticated().
    match /projectTrx/{transactionId} {
      // PT-1: INACTIVE members excluded; finance/board-only gate mirrors transactions collection
      // PT-R1: split get/list so loId scoping works in list queries (resource.data is null in list)
      allow get: if isAuthenticated() && (isAdmin() || isBoard() || canAccessFinance());
      // E7 fix: add isAdmin() guard so admin batch scans are not blocked by resource.data-null list rules
      allow list: if isAuthenticated() && (isAdmin() || isBoard() ||
        (canAccessFinance() && getMyLoId() != null));
      // E1 fix: add hasOnly to prevent arbitrary fields being written on create
      // PT-C1: expanded from isFinanceOperator() to isBoard()||isAdmin() — project committee members
      //        need to log entries for their own projects; purpose+category added to whitelist
      allow create: if (isBoard() || isAdmin()) &&
        request.resource.data.keys().hasAll(['projectId', 'amount', 'type']) &&
        request.resource.data.keys().hasOnly([
          'projectId', 'amount', 'type', 'description', 'date', 'createdBy', 'createdAt',
          'bankAccountId', 'loId', 'currency', 'status', 'updatedAt', 'purpose', 'category'
        ]);
      // PT-update/delete: block modifications to already-reconciled project transactions; PT-U2: add hasOnly
      allow update: if (isBoard() || isAdmin()) &&
        resource.data.get('status', '') != 'Reconciled' &&
        (isAdmin() ||
         request.resource.data.diff(resource.data).affectedKeys().hasOnly([
           'description', 'amount', 'type', 'date', 'category', 'purpose', 'notes',
           'reference', 'attachments', 'updatedAt', 'updatedBy', 'approvedBy', 'approvedAt',
           'rejectedBy', 'rejectedAt', 'rejectionReason'
         ]));
      allow delete: if (isBoard() || isAdmin()) &&
        resource.data.get('status', '') != 'Reconciled';
    }
    

    // Bank Accounts: Board+ can view; only Honorary Treasurer (or Admin) can create/update/delete.
    match /bankAccounts/{accountId} {
      allow get: if canAccessFinance() &&
        (isAdmin() ||
         resource.data.get('loId', null) == null ||
         resource.data.get('loId', null) == getMyLoId());
      allow list: if isAdmin() || canAccessFinance();
      allow create, update, delete: if isAdmin() || isFinanceOperator();
    }
    
    // Payment Requests (Story 2.1): applicantId, amount, purpose, activityRef, referenceNumber, status, loId, 审计
    function paymentRequestInMyScope() {
      let myLo = getMyLoId();
      let docLo = resource.data.get('loId', null);
      // 财政可见：同 LO，或文档无 loId（兼容旧数据），或本人无 loId 视为单 LO 可见全部
      return docLo == myLo || docLo == null || myLo == null;
    }
    match /paymentRequests/{requestId} {
      allow get: if isAuthenticated() &&
        (isAdmin() ||
         resource.data.get('applicantId', null) == request.auth.uid ||
         (canAccessFinance() && paymentRequestInMyScope()));
      // allow list: members can list their own (service adds where('applicantId','==',uid)); finance sees all
      // resource.data is null in list queries — ownership enforced by service-layer filter only
      allow list: if isAuthenticated() &&
        (isAdmin() || canAccessFinance() || isMember());
      allow create: if isInternalUser() &&
        // Admin/finance/board may submit on behalf of another member; regular members can only submit for themselves.
        (isAdmin() || canAccessFinance() || isBoard() ||
          request.resource.data.get('applicantId', null) == request.auth.uid) &&
        request.resource.data.get('loId', null) is string &&
        request.resource.data.get('referenceNumber', null) is string &&
        request.resource.data.get('status', null) in ['draft', 'submitted'];
      allow update: if isAuthenticated() &&
        (isAdmin() ||
         resource.data.get('applicantId', null) == request.auth.uid && resource.data.get('status', null) == 'draft' &&
           // E4 fix: added 'purpose' — service writes purpose alongside title/description on draft edit
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'description', 'purpose', 'amount', 'totalAmount', 'activityRef', 'items', 'attachments', 'category', 'updatedAt', 'updatedBy', 'status']) &&
           request.resource.data.get('status', null) in ['draft', 'submitted'] ||
         resource.data.get('applicantId', null) == request.auth.uid && resource.data.get('status', null) in ['submitted', 'approved'] && request.resource.data.get('status', null) == 'cancelled' &&
           // E2 fix: added 'expenseTxFailed' — service writes this flag when transaction delete fails on cancel
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'updatedBy', 'expenseTxFailed']) ||
         resource.data.get('applicantId', null) == request.auth.uid && resource.data.get('status', null) == 'rejected' && request.resource.data.get('status', null) == 'submitted' &&
           // E1 fix: added rejectionReason/reviewedBy/reviewedAt — service clears these on resubmit
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'updatedBy', 'rejectionReason', 'reviewedBy', 'reviewedAt']) ||
         canAccessFinance() && paymentRequestInMyScope() &&
           // Fix 9 (P2): added 'projectBudgetSyncFailed' and 'expenseTxFailed' so finance staff
           // can write these flag fields without needing admin rights.
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedBy', 'reviewedAt', 'updatedAt', 'updatedBy', 'remark', 'rejectionReason', 'paidAt', 'projectBudgetSyncFailed', 'expenseTxFailed']) ||
         // Allow the submitter (applicant or admin acting on their behalf) to set combinedPdfFileId
         // immediately after PR creation. Admins who submitted on behalf of others are also permitted.
         (resource.data.get('applicantId', null) == request.auth.uid || isAdmin() || canAccessFinance() || isBoard()) &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['combinedPdfFileId']));
      allow delete: if isAuthenticated() && (
        (resource.data.get('applicantId', null) == request.auth.uid && resource.data.get('status', null) == 'draft') ||
        isAdmin() || isDeveloper());
    }

    // Story 9.1: 非会员留资
    // FIX 15: allow create: if true had no field validation — bots/spammers could write arbitrary content
    match /nonMemberLeads/{leadId} {
      allow read: if isAuthenticated() && canReadOrgMembers();
      // P0 Fix: removed isAuthenticated() requirement — public form submissions come from unauthenticated users.
      // Field validation prevents arbitrary writes: required fields enforced via hasAll, allowlist via hasOnly.
      allow create: if request.resource.data.keys().hasAll(['name', 'email', 'source', 'createdAt']) &&
                      request.resource.data.keys().hasOnly(['name', 'email', 'phone', 'source', 'message', 'createdAt', 'eventId', 'loId']);
      allow update, delete: if isAuthenticated() && canReadOrgMembers();
    }

    // Story 8.1: 报名/缴费/签到统一名单
    // Fields a member may self-service on their own registration (non-financial).
    // Anything payment/status related must go through canReadOrgMembers() (board/finance/committee).
    // E-4: protect audit fields (cancelledBy*, registeredBy*, memberName) from self-write
    function eventRegSelfUpdateOnlyTouchesOwnFields() {
      let unchanged = ['status', 'paidAt', 'checkedInAt', 'paymentMethod', 'financeTransactionId',
        'matchedBankTxId', 'toyyibBillCode', 'toyyibPaymentUrl', 'toyyibPaymentStatus', 'billExternalReferenceNo',
        'cancelledAt', 'cancelledBy', 'cancelledByName', 'cancelledByRole',
        'registeredBy', 'registeredByName', 'memberName',
        'eventId', 'memberId', 'loId', 'createdAt', 'updatedAt'];
      return unchanged.toSet().difference(request.resource.data.diff(resource.data).affectedKeys()).size() == unchanged.size();
    }
    match /eventRegistrations/{regId} {
      // ER-R1: split get/list — resource.data is null in list queries; members can only self-read via get
      allow get: if isAuthenticated() &&
        (isAdmin() || resource.data.get('memberId', null) == request.auth.uid || canReadOrgMembers());
      // Members may list their own registrations (service adds where('memberId','==',uid)); Board+ lists all.
      // Active external users: own registrations only — the query must carry where('memberId','==',uid).
      allow list: if isAuthenticated() && (isAdmin() || canReadOrgMembers() || isMember() ||
        (isActiveExternal() && resource.data.memberId == request.auth.uid));
      allow create: if isAuthenticated() &&
        (!isExternal() || isActiveExternal()) &&
        request.resource.data.get('memberId', null) is string &&
        request.resource.data.get('eventId', null) is string &&
        (request.resource.data.get('memberId', null) == request.auth.uid || canReadOrgMembers()) &&
        request.resource.data.get('status', 'registered') == 'registered';
      // ER-U4: Board update add hasOnly — prevent overwriting points/attendedAt/memberId from SDK
      allow update: if isAuthenticated() &&
        ((canReadOrgMembers() && (isAdmin() ||
           request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'status', 'paidAt', 'checkedInAt', 'paymentMethod', 'financeTransactionId',
             'matchedBankTxId', 'toyyibBillCode', 'toyyibPaymentUrl', 'toyyibPaymentStatus',
             'billExternalReferenceNo', 'cancelledAt', 'cancelledBy', 'cancelledByName', 'cancelledByRole',
             'registeredBy', 'registeredByName', 'memberName', 'notes', 'updatedAt', 'updatedBy',
             'points', 'attendedAt', 'attended'
           ]))) ||
         (resource.data.get('memberId', null) == request.auth.uid && eventRegSelfUpdateOnlyTouchesOwnFields()));
      // E-1: members may NOT hard-delete their own registration (bypasses finance tx cleanup); only board+ can delete
      allow delete: if isAuthenticated() && canReadOrgMembers();
    }
    
    // Points collection
    match /points/{pointId} {
      allow read: if isInternalUser();
      // P0 fix: members must NOT be able to self-submit point records — that is self-score fraud.
      // Only board members and admins may create point records on behalf of any member.
      allow create: if isBoard() || isAdmin();
      allow update, delete: if isAdmin() || isBoard();
    }
    
    // Notifications collection
    match /notifications/{notificationId} {
      // E1 fix (P0): allow read was used for both get and list, but resource.data is null in list queries,
      // so the memberId == uid check always failed — members could never see their own notifications.
      // Fix: split into get (resource.data valid) and list (service-layer where clause enforces ownership).
      allow get: if isAuthenticated() &&
                    (resource.data.memberId == request.auth.uid ||
                     (exists(/databases/$(database)/documents/members/$(request.auth.uid)) &&
                      get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role in ['BOARD', 'ADMIN', 'SUPER_ADMIN']));
      // INTENTIONAL DESIGN: resource.data is unavailable in list queries, so ownership cannot be
      // enforced at the Firestore-rules layer for list. The service layer MUST always include
      // where('memberId', '==', uid) in every list query — this prevents unfiltered reads from
      // returning useful data even if rules pass. A compound index on (memberId ASC, timestamp DESC)
      // must exist so Firestore rejects queries that omit the memberId equality filter.
      // Tightened from isMember() to isAdmin()||isBoard() to prevent members from querying all notifications.
      allow list: if isAuthenticated() && (isAdmin() || isBoard());
      
      // PR-C: MEMBER cancel/submit notifications need create rights; N-8: require all fields present
      // isBoard() for general notifications; isMember() for specific self-service action types only
      allow create: if isAuthenticated() && (isBoard() ||
        (isMember() &&
         request.resource.data.keys().hasAll(['memberId','title','message','type','read']) &&
         request.resource.data.get('type', '') in [
           'payment_request_cancelled', 'payment_request_submitted',
           'payment_request_updated', 'event_registration_cancelled',
           'info', 'success', 'warning', 'error'
         ]));

      // Users can mark their own notifications as read; board/admin can update any field
      allow update: if isAuthenticated() &&
                       (isAdmin() ||
                        (exists(/databases/$(database)/documents/members/$(request.auth.uid)) &&
                         get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role in ['BOARD', 'ADMIN', 'SUPER_ADMIN']) ||
                        (resource.data.memberId == request.auth.uid &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt'])));
      
      // N-7: allow members to delete their own notifications for inbox cleanup
      allow delete: if isAuthenticated() &&
                       (resource.data.memberId == request.auth.uid ||
                        (exists(/databases/$(database)/documents/members/$(request.auth.uid)) &&
                         get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role in ['BOARD', 'ADMIN', 'SUPER_ADMIN']));
    }

    // Documents collection
    // FIX 7: restrict writes to Board/Admin — any member was previously able to create/update/delete governance docs
    match /documents/{documentId} {
      allow read: if isInternalUser();
      allow create, update: if isBoard() || isAdmin();
      allow delete: if isAdmin();
    }

    // Document Versions collection
    // FIX 6: was completely missing (default deny) — version history operations always silently failed
    match /documentVersions/{versionId} {
      allow read: if isInternalUser();
      allow create: if isBoard() || isAdmin();
      allow update, delete: if isAdmin();
    }
    
    // Surveys collection — SUPER_ADMIN included via isAdmin()
    match /surveys/{surveyId} {
      // External users: only surveys targeted to them via the existing 'Specific Group' list
      // (list query must carry where('specificMemberIds','array-contains',uid)).
      allow read: if isInternalUser() ||
                     (isActiveExternal() && request.auth.uid in resource.data.specificMemberIds);
      allow create, update, delete: if isBoard() || isAdmin();
    }
    
    // Survey Responses collection
    // FIX 5: allow read used resource.data.memberId which is null in list queries — members could never list their own responses
    match /surveyResponses/{responseId} {
      // resource.data valid for get; service-layer where(memberId == uid) handles list ownership
      allow get: if isAuthenticated() &&
                    (resource.data.memberId == request.auth.uid || isBoard() || isAdmin());
      allow list: if isActiveMember() ||
                     (isActiveExternal() && resource.data.memberId == request.auth.uid);
      // FIX: added required field validation to prevent partial/malformed responses
      // DEDUP: !exists() check prevents duplicate submissions when service uses memberId_surveyId as doc ID.
      // Service MUST use a deterministic responseId = memberId + '_' + surveyId when calling setDoc.
      allow create: if isAuthenticated() &&
                      request.resource.data.memberId == request.auth.uid &&
                      request.resource.data.keys().hasAll(['surveyId', 'memberId', 'responses', 'submittedAt']) &&
                      !exists(/databases/$(database)/documents/surveyResponses/$(responseId)) &&
                      // External users may only answer surveys targeted to them.
                      (!isExternal() ||
                       (isActiveExternal() &&
                        request.auth.uid in get(/databases/$(database)/documents/surveys/$(request.resource.data.surveyId)).data.get('specificMemberIds', [])));
      allow update, delete: if isBoard() || isAdmin();
    }

    // Workflows collection
    match /workflows/{workflowId} {
      // FIX 11: list rule must not use resource.data (null in list queries).
      // Restricted to Board+; delete to Admin only — workflow deletion can silence automation.
      allow read: if isBoard() || isAdmin();
      allow create, update: if isBoard() || isAdmin();
      allow delete: if isAdmin();
    }
    
    // Workflow Executions collection
    // FIX 8: restrict reads to Board/Admin; create restricted to Board/Admin (was isAuthenticated — anyone could forge execution records)
    match /workflow_executions/{executionId} {
      allow read: if isBoard() || isAdmin();
      allow create: if isAdmin() || isBoard();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // Automation Rules collection — restricted to Board/Admin (members should not read webhook/trigger configs)
    match /automationRules/{ruleId} {
      allow read: if isBoard() || isAdmin();
      // FIX 9: delete restricted to Admin only — a BOARD member deleting a rule can silently
      // disable automation (e.g. membership renewal reminders) with no audit trail.
      allow create, update: if isBoard() || isAdmin();
      allow delete: if isAdmin();
    }
    
    // Inventory collection
    // I-8: update hasOnly — lock system fields (createdAt, lastTransactionId) from direct overwrite
    // C12: restrict read to isMember() to exclude GUEST/INACTIVE
    match /inventory/{itemId} {
      allow read: if isAuthenticated() && isMember();
      allow create, delete: if isFinanceOperator();
      allow update: if isFinanceOperator() &&
        (
         // E4 fix: removed 'lastTransactionId' and 'lastTransactionDate' — these are system-managed
         // link fields written by the inventory transaction service, not by Board users directly.
         request.resource.data.diff(resource.data).affectedKeys().hasOnly([
           'name', 'description', 'quantity', 'status', 'location', 'variants',
           'minQuantity', 'category', 'purchasePrice', 'depreciatedValue', 'notes',
           'lastCheckedAt', 'checkedOutTo', 'checkedOutDate', 'expectedReturnDate',
           'updatedAt', 'updatedBy', 'tags', 'serialNumber', 'condition',
           'returnedDate', 'lastSaleDate', 'purchaseDate', 'currentValue', 'lastDepreciationUpdate',
           'nextMaintenanceDate', 'resolved', 'resolvedAt'
         ]));
    }

    // Stock Movements collection
    // I-4: restrict read to MEMBER+ (was isAuthenticated which includes GUEST)
    // FIX 21: removed allow update — stock movements are audit records and must be append-only;
    //         Board was able to overwrite movement records, corrupting the inventory audit trail
    match /stock_movements/{movementId} {
      allow read: if isAuthenticated() && isMember();
      allow create: if isFinanceOperator();
      // No allow update — stock movements are immutable audit records
      allow delete: if isAdmin();
    }
    
    // Hobby Clubs collection
    // FIX 12: any authenticated user (including GUEST) could create/update/delete any club
    match /hobbyClubs/{clubId} {
      allow read: if isInternalUser() || isActiveExternal();  // whitelisted module: hobby clubs
      // P2 Fix: exclude GUEST role from creating clubs — only MEMBER and above.
      allow create: if (isMember() && getUserRole() != 'GUEST') || isBoard() || isAdmin();
      // Club lead can update descriptive fields only — leadId and memberIds are admin-managed
      allow update: if isBoard() || isAdmin() ||
                      (isMember() && resource.data.leadId == request.auth.uid
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['leadId', 'memberIds']));
      allow delete: if isAdmin();
    }
    
    // Business Profiles collection
    // FIX 20: allow update was checking request.resource.data.memberId (new data) — attacker sets memberId to self
    //         to claim any profile; must check resource.data.memberId (existing owner)
    match /businessProfiles/{profileId} {
      allow read: if isInternalUser();
      allow create: if isInternalUser() && request.resource.data.memberId == request.auth.uid;
      // Owner can update non-identity fields only — memberId must not change
      allow update: if isAdmin() || (isAuthenticated() && resource.data.memberId == request.auth.uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['memberId']));
      allow delete: if isAdmin() || isBoard();
    }
    
    // Inquiries collection (Business Directory)
    // FIX 3: allow read used resource.data in list queries (always null) — members could never list their inquiries
    match /inquiries/{inquiryId} {
      allow get: if isAuthenticated() &&
                    (resource.data.senderId == request.auth.uid ||
                     resource.data.recipientId == request.auth.uid ||
                     isBoard() || isAdmin());
      allow list: if isBoard() || isAdmin() || isMember();
      allow create: if isInternalUser() &&
                       request.resource.data.senderId == request.auth.uid;
      allow update: if isAuthenticated() &&
                       (resource.data.senderId == request.auth.uid ||
                        resource.data.recipientId == request.auth.uid ||
                        (exists(/databases/$(database)/documents/members/$(request.auth.uid)) &&
                         get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role in ['BOARD', 'ADMIN', 'SUPER_ADMIN']));
      allow delete: if isAuthenticated() &&
                       exists(/databases/$(database)/documents/members/$(request.auth.uid)) &&
                       get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role in ['BOARD', 'ADMIN', 'SUPER_ADMIN'];
    }

    // Badges collection
    match /badges/{badgeId} {
      allow read: if isInternalUser();
      allow create, update, delete: if isBoard();
    }
    
    // Badge Awards collection
    match /badgeAwards/{awardId} {
      allow read: if isInternalUser();
      allow create: if isBoard();
      allow update, delete: if isBoard();
    }
    
    // Achievements collection
    match /achievements/{achievementId} {
      allow read: if isInternalUser();
      allow create, update, delete: if isBoard();
    }
    
    // Achievement Awards collection
    match /achievementAwards/{awardId} {
      allow read: if isInternalUser();
      allow create: if isBoard();
      allow update, delete: if isBoard();
    }
    
    // Advertisements collection
    // FIX 13: update click/impression tracking branch was missing isAuthenticated() — anonymous users could spam counters
    match /advertisements/{adId} {
      allow read: if true;
      // P0 Fix: create/delete require Board or Admin (not Board alone)
      allow create, delete: if isBoard() || isAdmin();
      // P0 Fix: anonymous users cannot update; authenticated users may only increment view/click counters
      allow update: if isBoard() || isAdmin() ||
        (isAuthenticated() &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['impressions', 'clicks', 'updatedAt']));
    }
    
    // Promotion Packages collection
    match /promotionPackages/{packageId} {
      allow read: if isInternalUser();
      allow create, update, delete: if isBoard();
    }

    // Probation to Full Member promotion workflow
    match /manualPromotionRequests/{requestId} {
      // FIX: allow the applicant to read their own promotion request
      // P1 Fix: split read into get/list — resource.data is null in list queries so the memberId
      //         check always failed; list is Board/Admin only; members get their own via service get.
      allow get: if isBoard() || isAdmin() || isDeveloper() || request.auth.uid == resource.data.memberId;
      allow list: if isBoard() || isAdmin() || isDeveloper();
      // P0 fix: non-override creates must have status == 'pending'; only admins can create
      // directly as 'approved' (atomic override path in promoteToOfficialMember writeBatch).
      allow create: if ((isBoard() || isAdmin() || isDeveloper()) && request.resource.data.status == 'pending')
                    || (isAdmin() && request.resource.data.status == 'approved');
      allow update, delete: if isBoard() || isAdmin() || isDeveloper();
    }

    match /promotionHistory/{historyId} {
      // FIX: allow the subject member to read their own promotion history
      // FIX 4: split read — resource.data is null in list queries so memberId check always failed for lists
      allow get: if isBoard() || isAdmin() || isDeveloper() || resource.data.memberId == request.auth.uid;
      allow list: if isBoard() || isAdmin() || isDeveloper() || isMember();
      allow create, update, delete: if isBoard() || isAdmin() || isDeveloper();
    }
    
    // Activity Plans collection
    // Members need to submit their own activity plans; Board/Admin can moderate; delete is Board/Admin only
    match /activityPlans/{planId} {
      allow read: if isInternalUser();
      allow create: if isInternalUser();
      allow update: if isBoard() || isAdmin();
      allow delete: if isBoard() || isAdmin();
    }
    
    // Templates collection — SUPER_ADMIN (via isAdmin()) can manage templates
    match /templates/{templateId} {
      allow read: if isInternalUser();
      allow create, update, delete: if isBoard() || isAdmin();
    }
    
    // Member Benefits collection
    match /memberBenefits/{benefitId} {
      allow read: if isInternalUser() || isActiveExternal();  // whitelisted module: member benefits
      allow create, update, delete: if isBoard();
    }
    
    // Benefit Usage collection
    match /benefitUsage/{usageId} {
      // External users: own usage only (list query must carry where('memberId','==',uid)).
      allow read: if isInternalUser() ||
                     (isActiveExternal() && resource.data.memberId == request.auth.uid);
      allow create: if isAuthenticated() &&
        (!isExternal() || isActiveExternal()) &&
        request.resource.data.memberId == request.auth.uid &&
        request.resource.data.keys().hasOnly(['memberId', 'benefitId', 'usedAt', 'notes', 'details', 'createdAt', 'loId']);
      allow update, delete: if isAuthenticated() &&
                               exists(/databases/$(database)/documents/members/$(request.auth.uid)) &&
                               get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role in ['BOARD', 'ADMIN', 'SUPER_ADMIN'];
    }
    
    // Webhooks collection
    match /webhooks/{webhookId} {
      allow read, create, update, delete: if isAuthenticated() && 
                                             exists(/databases/$(database)/documents/members/$(request.auth.uid)) &&
                                             get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role in ['BOARD', 'ADMIN', 'SUPER_ADMIN'];
    }
    
    // Webhook Logs collection
    // Board can create webhook logs (for testing/forwarding); Admin manages
    // hasOnly() whitelist prevents extra fields being injected on create
    match /webhook_logs/{logId} {
      allow read: if isBoard() || isAdmin();
      allow create: if (isBoard() || isAdmin()) &&
                       request.resource.data.keys().hasOnly([
                         'webhookId', 'event', 'status', 'responseCode',
                         'responseBody', 'error', 'triggeredAt', 'duration'
                       ]);
      allow update: if false;
      allow delete: if isAdmin();
    }
    
    // Reconciliations collection
    // R-1: use isAdmin()/isBoard() so SUPER_ADMIN is included (was excluded by hardcoded role list)
    // R-8: delete restricted to Admin only — BOARD must not be able to erase audit records
    // R-3: update hasOnly — BOARD cannot overwrite core audit fields (statementBalance, reconciledBy, etc.)
    match /reconciliations/{reconciliationId} {
      // R-5: split get/list so isAdmin() bypass works for batch admin scans (resource.data null in list)
      allow get: if isAuthenticated() && (isAdmin() || isBoard());
      allow list: if isAuthenticated() && (isAdmin() || isBoard());
      allow create: if isAuthenticated() && (isAdmin() || isBoard()) &&
        request.resource.data.keys().hasAll(['bankAccountId', 'reconciliationDate', 'reconciledBy']);
      // E6 fix: removed 'status' from BOARD hasOnly — Board must not revert completed reconciliations.
      // Status changes (e.g. in_progress → completed) require Admin.
      allow update: if isAuthenticated() && (isAdmin() ||
        (isBoard() && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'notes', 'updatedAt', 'updatedBy'
        ])));
      allow delete: if isAuthenticated() && isAdmin();
    }
    
    // Event Budgets collection
    // FIX 5: restrict read to Board/Admin or budget creator; add field whitelist on update for non-Admin
    // P1 Fix: split read into get/list — resource.data is null in list queries so createdBy check
    //         always failed for list operations; list is Board/Admin only.
    match /eventBudgets/{budgetId} {
      allow get: if isAuthenticated() && (isBoard() || isAdmin() || request.auth.uid == resource.data.createdBy);
      allow list: if isBoard() || isAdmin();
      allow create, delete: if isBoard() || isAdmin();
      allow update: if isAdmin() ||
                      (isBoard() &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                         'actualAmount', 'items', 'notes', 'status', 'updatedAt', 'updatedBy'
                       ]));
    }
    
    // Event Feedback collection
    // FIX 9: allow read was fully open — feedback contains memberId and rating visible to all;
    //        allow create had no field validation — anyone could submit on behalf of another member
    match /eventFeedback/{feedbackId} {
      // resource.data valid on get; list is board-only to protect submitter identity
      allow get: if isBoard() || isAdmin() || (isAuthenticated() && resource.data.memberId == request.auth.uid);
      allow list: if isBoard() || isAdmin();
      allow create: if (isInternalUser() || isActiveExternal()) &&
                      request.resource.data.memberId == request.auth.uid &&
                      request.resource.data.keys().hasAll(['memberId', 'eventId', 'rating', 'submittedAt']);
      allow update, delete: if isBoard() || isAdmin();
    }
    
    // Project Reports collection
    // FIX 23: any authenticated user could create/update/delete project reports
    match /projectReports/{reportId} {
      allow read: if isBoard() || isAdmin();
      allow create, update: if isBoard() || isAdmin();
      allow delete: if isAdmin();
    }
    
    // Guest Registrations collection
    // FIX 22: allow update had no hasOnly whitelist — Board could overwrite any field including immutable registration data
    match /guestRegistrations/{registrationId} {
      allow read: if isBoard() || isAdmin();
      // FIX 5: allow create: if true had no field validation — bots could write arbitrary content
      // Fields from eventsService.ts: eventId, name, email, phone, registeredAt, status, organization, notes
      allow create: if request.resource.data.keys().hasAll(['name', 'email', 'eventId', 'registeredAt'])
                    && request.resource.data.keys().hasOnly(['name', 'email', 'phone', 'eventId', 'organization', 'notes', 'registeredAt', 'status', '_indexFor']);
      allow update: if (isBoard() || isAdmin()) &&
                      request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['status', 'checkedIn', 'checkedInAt', 'notes', 'updatedAt']);
      allow delete: if isBoard();
    }
    
    // Board of Directors: boardMembers, boardTransitions (public read for guest About page)
    match /boardMembers/{docId} {
      allow read: if true;
      allow create, delete: if isBoard();
      // hasOnly prevents a BOARD member from overwriting memberId (hijacking another person's slot)
      allow update: if isBoard() &&
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['role', 'displayRole', 'term', 'startDate', 'endDate',
                                   'updatedAt', 'photoUrl', 'description', 'isActive',
                                   'memberName', 'avatarUrl', 'companyName']);
    }
    match /boardTransitions/{docId} {
      allow read: if true;
      allow create, update, delete: if isBoard();
    }
    // Presidential term settings (theme, tagline, description, logo) — public read for guest home page
    match /boardTermSettings/{docId} {
      allow read: if true;
      allow create, update, delete: if isBoard();
    }
    
    // Zoom Bookings
    match /zoomBookings/{docId} {
      allow list: if isMember();
      allow get: if isMember();
      allow create: if isMember() && request.resource.data.memberId == request.auth.uid;
      allow update: if isBoard() || (isMember() && resource.data.memberId == request.auth.uid);
      allow delete: if false;
    }

    // Mentorship: mentorMatches, mentorshipFeedback (Mentor Matching / stats)
    match /mentorMatches/{docId} {
      // FIX 10: restrict read to isMember() — GUEST/INACTIVE should not see mentorship matches.
      // list rule is safe (no resource.data condition); get for self or board.
      allow get: if isAuthenticated() && (isBoard() || isAdmin() ||
                     resource.data.mentorId == request.auth.uid ||
                     resource.data.menteeId == request.auth.uid);
      allow list: if isInternalUser();
      allow create: if isInternalUser() &&
                     exists(/databases/$(database)/documents/members/$(request.auth.uid)) &&
                     (getUserRole() in ['BOARD', 'ADMIN', 'SUPER_ADMIN'] ||
                      request.resource.data.mentorId == request.auth.uid ||
                      request.resource.data.menteeId == request.auth.uid);
      // FIX 22: split update/delete; add hasOnly whitelist so mentor/mentee can only change safe fields
      allow update: if isAuthenticated() &&
                     (
                       (exists(/databases/$(database)/documents/members/$(request.auth.uid)) &&
                        getUserRole() in ['BOARD', 'ADMIN', 'SUPER_ADMIN']) ||
                       ((resource.data.mentorId == request.auth.uid ||
                         resource.data.menteeId == request.auth.uid) &&
                        request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['status', 'acceptedAt', 'completedAt', 'updatedAt', 'notes']))
                     );
      allow delete: if isAuthenticated() &&
                     exists(/databases/$(database)/documents/members/$(request.auth.uid)) &&
                     getUserRole() in ['BOARD', 'ADMIN', 'SUPER_ADMIN'];
    }
    match /mentorshipFeedback/{docId} {
      allow read: if isAuthenticated() && 
                     exists(/databases/$(database)/documents/members/$(request.auth.uid)) &&
                     getUserRole() in ['BOARD', 'ADMIN', 'SUPER_ADMIN'];
      allow create: if isInternalUser();
      allow update, delete: if isAuthenticated() && getUserRole() in ['BOARD', 'ADMIN', 'SUPER_ADMIN'];
    }
    
    // Knowledge / Learning: training modules, learning paths, progress, certificates
    match /trainingModules/{docId} {
      allow read: if isAdmin() || (isAuthenticated() && getUserRole() in ['GUEST', 'MEMBER', 'BOARD', 'ADMIN', 'SUPER_ADMIN']);
      allow create, update, delete: if isBoard();
    }
    match /learningPaths/{docId} {
      allow read: if isInternalUser();
      allow create, update, delete: if isBoard();
    }
    // FIX 11: allow read used resource.data.memberId which is null in list queries — members could never list their own progress
    match /learningProgress/{docId} {
      // resource.data valid on get; list trusted to service-layer where(memberId == uid) filter
      allow get: if isAuthenticated() && (isBoard() || isAdmin() || resource.data.memberId == request.auth.uid);
      allow list: if isMember() || isBoard() || isAdmin();
      allow create: if isInternalUser() && request.resource.data.memberId == request.auth.uid;
      allow update, delete: if isBoard() || isAdmin() || (isAuthenticated() && resource.data.memberId == request.auth.uid);
    }
    // Inventory: maintenance schedules, inventory alerts (InventoryView)
    match /maintenance_schedules/{docId} {
      // FIX: removed getUserRole()-in-list resource.data check that blocked list queries; simplified to isMember()
      allow read: if isAuthenticated() && isMember();
      // FIX: added hasOnly whitelist on create to prevent arbitrary field injection
      allow create: if isFinanceOperator() &&
        request.resource.data.keys().hasOnly([
          'itemId','scheduledDate','nextMaintenanceDate','frequency','assignedTo','status','notes','createdAt','loId',
          'updatedAt','type','description','priority','estimatedDuration'
        ]);
      // FIX: added hasOnly on update to lock immutable fields (itemId)
      allow update: if isFinanceOperator() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'scheduledDate','nextMaintenanceDate','frequency','assignedTo','status','notes','updatedAt','completedAt','completedBy'
        ]);
      allow delete: if isFinanceOperator();
    }
    match /inventory_alerts/{docId} {
      allow read: if isAuthenticated() && isMember();
      // E9 fix: split create from update/delete to add field whitelist on create
      // FIX: added 'acknowledged' to hasOnly list
      allow create: if isFinanceOperator() &&
        request.resource.data.keys().hasAll(['itemId', 'type', 'severity', 'message']) &&
        request.resource.data.keys().hasOnly([
          'itemId', 'type', 'severity', 'message', 'threshold', 'currentValue',
          'createdAt', 'loId', 'resolved', 'acknowledged'
        ]);
      // FIX: added hasOnly whitelist to update — acknowledgement and resolution fields writable by Board
      allow update: if isFinanceOperator() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'acknowledged','acknowledgedBy','acknowledgedAt','resolved','resolvedAt'
        ]);
      allow delete: if isFinanceOperator();
    }
    
    // Finance: payment requests — superseded by the scoped rule above (line ~244);
    // this collection is intentionally NOT re-declared here to avoid re-opening the
    // isMember()-for-everything hole (see match /paymentRequests/{requestId} above).

    // Contract System Collections
    match /contracts/{contractId} {
      // FIX 13: split read (resource.data null in list); restrict writes; hasOnly for member signing.
      allow get: if isAuthenticated() && (isAdmin() || isBoard() ||
                     resource.data.memberId == request.auth.uid);
      allow list: if isBoard() || isAdmin();
      allow create: if isMember() &&
                       (!request.resource.data.keys().hasAny(['status']) ||
                        request.resource.data.get('status', '') in ['Draft', 'Pending']);
      // Members may only update their own signature fields; board/admin unrestricted
      // FIX 4: restrict status values members can set — prevent self-escalation to 'active'/'completed'
      // FIX 18: added 'signedAt', 'signedBy' — service writes these alongside status on signing
      allow update: if isAdmin() || isBoard() ||
                       (isMember() &&
                        request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['signerIds', 'signedAt', 'signedBy', 'status', 'proofUrl', 'updatedAt']) &&
                        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']) ||
                         request.resource.data.get('status', '') in ['pending_signature', 'signed', 'verifying']));
      allow delete: if isAdmin();
    }
    match /pointEscrow/{escrowId} {
      // FIX 5: split read (resource.data null in list); restrict create/update/delete.
      // Any authenticated user was able to create and modify escrow records.
      allow get: if isAuthenticated() && (isBoard() || isAdmin() ||
                     resource.data.memberId == request.auth.uid);
      allow list: if isBoard() || isAdmin();
      // P0 fix: service writes status='Locked' (not 'pending') and includes fields like
      // purpose, relatedEntityId, description, expiresAt — updated hasOnly and status to match.
      // lockPointsForEscrow always runs inside a runTransaction initiated by the member.
      allow create: if isAdmin() ||
                       (isMember() &&
                        request.resource.data.memberId == request.auth.uid &&
                        request.resource.data.get('status', '') == 'Locked' &&
                        request.resource.data.keys().hasOnly([
                          'memberId', 'amount', 'purpose', 'relatedEntityId',
                          'status', 'description', 'createdAt', 'expiresAt'
                        ]));
      // P0 fix: add 'releasedTo' to the update whitelist — releaseEscrow writes this field.
      // Board can update status/release fields only; admin unrestricted.
      allow update: if isAdmin() ||
                       (isBoard() &&
                        request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['status', 'releasedAt', 'releasedBy', 'releasedTo',
                                    'contractId', 'updatedAt', 'relatedEntityId']));
      allow delete: if isAdmin();
    }

    // JCI Gamification & LO Star Rating (New)
    match /incentivePrograms/{programId} {
      allow read: if isInternalUser();
      allow create, delete: if isAdmin();
      allow update: if isBoard() || isAdmin();
    }

    match /incentiveStandards/{standardId} {
      allow read: if isInternalUser();
      allow write: if isBoard();
    }

    match /incentiveSubmissions/{submissionId} {
      // FIX 6: resource.data is null in list queries, so the memberId/loId conditions always failed —
      // members could never see their own submissions in list views.
      // Split: get keeps the identity check; list trusts the service-layer where(memberId == uid) filter.
      allow get: if isAuthenticated() && (isAdmin() || isBoard() ||
                     resource.data.memberId == request.auth.uid);
      allow list: if isMember() || isAdmin();
      // P0 fix: Board/Admin must be allowed to create LO-level auto-calculated submissions
      // (syncSubmission in IncentiveCalculatorService writes docs with no memberId — they are
      // LO-level aggregates, not individual member claims).
      allow create: if isAdmin() || isBoard() ||
                       (isInternalUser() && request.resource.data.memberId == request.auth.uid);
      allow update, delete: if isBoard() || isAdmin();
    }

    match /loStarProgress/{progressId} {
      // FIX 14: tighten read — members see own progress via get; list safe (no resource.data condition).
      // isAdmin() covers SUPER_ADMIN which isBoard() does not always include.
      allow get: if isAdmin() || (isMember() && resource.data.memberId == request.auth.uid) || isBoard();
      allow list: if isMember();
      allow write: if isBoard() || isAdmin();
    }

    // System configuration (e.g., birthday_processor)
    match /system_config/{configId} {
      allow read: if isInternalUser();
      allow write: if isBoard() || isAdmin();
    }

    // System settings (membershipRules, pendingWhatsAppCampaign, etc.)
    // Readable by all authenticated users (config is non-sensitive).
    // Writable by ADMIN only — these are org-wide settings, not per-board.
    match /systemSettings/{docId} {
      allow read: if isInternalUser();
      allow write: if isAdmin();
    }

    // Registration History collection (formerly RadarContributions)
    match /RegistrationHistory/{entryId} {
      allow read: if isInternalUser();
      allow create, update, delete: if isBoard();
    }

    // Sponsorships collection
    match /sponsorships/{sponsorshipId} {
      allow read: if isInternalUser();
      allow create, update, delete: if isBoard() || isAdmin();
    }

    // System config collection (e.g. radar_mappings)
    match /system/{systemId} {
      allow read: if isInternalUser();
      allow create, update, delete: if isBoard();
    }

    // Atomic sequence counters (e.g. PR reference number generation).
    // Any authenticated member may run the generateReferenceNumber transaction
    // (read + set a {value: number} document). Field whitelist prevents arbitrary writes.
    match /counters/{counterId} {
      allow read: if isInternalUser();
      allow write: if isInternalUser() &&
                      request.resource.data.keys().hasOnly(['value']) &&
                      request.resource.data.value is int;
    }
    
    // Publications (E-Newsletters): public read for guest page; Board/Admin can manage
    match /publications/{docId} {
      allow read: if true;  // Public — shows on Guest E-Newsletters page
      allow create, update, delete: if isBoard();
    }

    // Public business directory (denormalized from members — guest-readable)
    match /publicBusinessListings/{listingId} {
      allow read: if true;
      // External users may not publish themselves on the KL public (guest) directory.
      allow create, update, delete: if isInternalUser() && (
        request.auth.uid == listingId || isBoard()
      );
    }
    
    // Client crash reports (web + APK) — authenticated users may create; Board reads; Admin deletes.
    // isAuthenticated() prevents anonymous bots from flooding the collection.
    // Unauthenticated APK crashes are lost, which is an acceptable trade-off vs spam.
    match /errorLogs/{docId} {
      allow read: if isBoard();
      allow create: if isAuthenticated();
      allow update: if isBoard();
      allow delete: if isAdmin();
    }

    // Guest page analytics — unauthenticated visitors increment counters; Board reads
    // FIX 16: allow update had no auth check — unauthenticated bots could inflate page view counters
    // FIX 16b: added docId format validation on create to prevent bots writing arbitrary keys
    // FIX 16c: added 10-second time throttle on update to limit bot flood writes
    match /guestPageStats/{docId} {
      // P0 Fix: allow any authenticated user to read stats (was Board-only)
      allow read: if isInternalUser();
      // setDoc({merge:true}) triggers create on new docs, update on existing ones.
      // Both must allow unauthenticated writes (analytics only, field-locked).
      // docId must be YYYY-MM-DD_<page> format to block arbitrary key injection
      allow create: if request.resource.id.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}_(home|events|projects|about|enewsletters|directory|partnerships)$')
        && request.resource.data.keys().hasOnly(
          ['page', 'date', 'views', 'dwellSeconds', 'signupClicks', 'updatedAt']
        );
      // Field whitelist on update: only counter fields and timestamp can change.
      // (Time-based throttle removed — resource.data.updatedAt is an ISO string,
      //  not a Firestore Timestamp, so duration arithmetic would always fail.)
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['views', 'dwellSeconds', 'signupClicks', 'updatedAt']);
      allow delete: if isAdmin();
    }

		// Partnership : public read for guest page; Board/Admin can manage
		match /partnerships/{docId} {
      allow read: if true;
      allow create, update, delete: if isBoard();
    }

    // ToyyibPay Categories: Board/Admin can manage; all authenticated members can read
    match /toyyibCategories/{categoryCode} {
      allow read: if isInternalUser();
      allow create, update, delete: if isBoard();
    }

    // ToyyibPay Bills
    // - Board/Admin can read and write all bills
    // - Members can read and create their own bills only (for dues/event payments)
    // - Webhook writes go through Admin SDK and bypass these rules
    match /toyyibBills/{billId} {
      allow get: if isBoard() ||
                    (isAuthenticated() && resource.data.memberId == request.auth.uid);
      allow list: if isBoard() || isAdmin() || isMember();
      allow create: if isBoard() ||
                       (isInternalUser() && request.resource.data.memberId == request.auth.uid);
      allow update, delete: if isBoard();
    }

    // Finance Alerts: written by server-side (Admin SDK / webhook) for issues requiring manual review.
    // Finance roles can read and mark as resolved; only Admin SDK (no auth) writes them.
    match /finance_alerts/{alertId} {
      // FA-6: Board can read individual alerts; only Admin can list full history via SDK
      // E1 fix: added isAdmin() prefix — SUPER_ADMIN is included in isAdmin() but not in isBoard()/canAccessFinance()
      allow get: if isAdmin() || canAccessFinance();
      allow list: if isAuthenticated() && (isAdmin() || isBoard());
      // FA-1: whitelist only resolution fields; block tampering with message/transactionId
      // E5 fix: added resolved == false precondition — already-resolved alerts cannot be re-modified
      allow update: if isFinanceOperator() &&
        resource.data.resolved == false &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          ['resolved', 'resolvedAt', 'resolvedBy', 'updatedAt']
        );
      // FA-C: Board/Admin can create finance alerts manually (e.g. flagging suspicious transaction).
      // Required fields enforced; resolved must be false on creation (unresolved alert).
      allow create: if (isBoard() || isAdmin()) &&
        request.resource.data.keys().hasAll(['type', 'message', 'createdAt']) &&
        request.resource.data.get('resolved', true) == false;
      // FA-5: Admin can delete invalid/stale alerts that can't be resolved
      allow delete: if isAuthenticated() && isAdmin();
    }

    // Audit log collection — immutable write-once records; Board can write audit events; Admin reads all
    // FIX: new block added; without this, auditLog had zero rules (default deny — all writes silently failed)
    match /auditLog/{logId} {
      allow read: if isAdmin();
      allow create: if isBoard() || isAdmin();
      allow update: if false;
      allow delete: if false;
    }

    // Firestore audit log — written by firestoreLogger (admin sessions only), read by admins only
    // P0 fix: restricted from isAuthenticated() to isAdmin() — any user could previously forge audit records
    // hasOnly() whitelist locks down the fields firestoreLogger is allowed to write
    match /systemLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin() &&
                       request.resource.data.keys().hasOnly([
                         'flushedAt', 'userId', 'windowMs', 'totalOps', 'entries'
                       ]);
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Email delivery log — written by email-sending service functions only (via Admin SDK / service layer)
    // Board can read logs for debugging; authenticated users may create (client-side email log writes); Admin manages
    match /emailLogs/{docId} {
      allow read: if isAdmin() || isBoard();
      allow create: if isInternalUser() || isActiveExternal();
      allow update, delete: if isAdmin();
    }

    // Member email dedup slots — one document per sanitised email address to enforce uniqueness
    // Members can read their own slot (to check status); only the service layer (Admin SDK) writes
    match /memberEmails/{email} {
      allow read: if isAuthenticated() && canReadOrgMembers();
      // Allow board/admin to create email slots via client SDK (membersService.createMember uses runTransaction)
      // Service layer enforces callerRole guard; Admin SDK migration is a future improvement
      allow create: if isBoard() || isAdmin();
      allow update, delete: if isAdmin();
    }

    // Points Rules collection (server-side automation rules — different from pointRules UI config)
    // FIX 1: collection had ZERO rules — all operations silently failed with default deny
    match /pointsRules/{id} {
      allow read: if isInternalUser();
      allow create, update, delete: if isBoard() || isAdmin();
    }

    // Points Rule Executions collection (execution log for automated point rule triggers)
    // FIX 1: collection had ZERO rules — execution logging always silently failed
    // allow create: isAuthenticated() so client-side points service can log executions; field whitelist limits injection risk
    match /pointsRuleExecutions/{id} {
      allow read: if isBoard() || isAdmin();
      allow create: if isInternalUser() &&
        request.resource.data.keys().hasOnly([
          'ruleId','ruleName','memberId','trigger','triggerData','pointsAwarded',
          'calculation','executedAt','status','reservedAt','loId'
        ]);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Achievement Progress collection (tracks per-member progress toward achievements)
    // FIX 14: collection had ZERO rules — unauthenticated users could read all achievement progress
    // FIX 6: tighten read — owner-only for members; Admin can read any record
    // P1 Fix: split read into get/list — resource.data is null in list queries so the memberId check
    //         always failed for list operations; list is Admin-only, members use service-layer get.
    match /achievementProgress/{id} {
      allow get: if isAuthenticated() && (request.auth.uid == resource.data.memberId || isAdmin() || isBoard());
      // P0 fix: members must be able to list their OWN progress docs (client queries filter by memberId).
      // resource.data is not available in list rules so owner-check must happen client-side via query filter.
      allow list: if isInternalUser();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ToyyibPay webhook payload mirror — written exclusively by Admin SDK in Netlify Functions
    // No client (browser) access needed; all reads/writes go through server-side code
    match /toyyibpay_webhooks/{docId} {
      allow read, write: if false;
    }

    // Birthday notification dedup log — written exclusively by Admin SDK / Cloud Function
    // No client access needed
    match /birthdayNotificationsSent/{docId} {
      allow read, write: if false;
    }

    // Permission configuration collections
    // Used by Config > Access. Authenticated users may read effective permission metadata;
    // only admins may change access rules.
    match /permissionCatalog/{permissionId} {
      allow read: if isInternalUser();
      allow create, update, delete: if isAdmin();
    }

    // Malaysian postcode → area/state lookup table
    // Readable by all authenticated users (needed for resolveArea on member save);
    // only admins may seed or edit entries.
    match /postcodes/{postcodeId} {
      allow read: if isAuthenticated();  // external users included (profile save resolves area)
      allow create, update, delete: if isAdmin();
    }

    match /userRolePermissions/{ruleId} {
      allow read: if isInternalUser();
      allow create, update, delete: if isAdmin();
    }

    match /membershipTypePermissions/{ruleId} {
      allow read: if isInternalUser();
      allow create, update, delete: if isAdmin();
    }

    match /positionPermissions/{ruleId} {
      allow read: if isInternalUser();
      allow create, update, delete: if isAdmin();
    }
    // Sister chapters — any authenticated member can read; only SUPER_ADMIN can write
    match /sisterChapters/{chapterId} {
      // Active external users read the chapter list too (names/countries/logos — no PII).
      allow read: if isActiveMember() || isActiveExternal();
      allow create, update, delete: if getUserRole() == 'SUPER_ADMIN';
    }

    // Social posts — members can create and read their own; BOD/Admin can read and update all
    match /socialPosts/{postId} {
      allow get: if isActiveMember() && (resource.data.submittedBy == request.auth.uid || isBoard());
      allow list: if isActiveMember();
      allow create: if isActiveMember() && request.resource.data.submittedBy == request.auth.uid
        && request.resource.data.status == 'draft'
        && request.resource.data.keys().hasAll(['title', 'rawContent', 'platforms', 'status', 'submittedBy', 'submittedByName', 'createdAt', 'updatedAt']);
      allow update: if isBoard() || isAdmin()
        || (isActiveMember() && resource.data.submittedBy == request.auth.uid
            && resource.data.status in ['draft', 'rejected']
            && request.resource.data.status in ['draft', 'pending_review']);
      allow delete: if isAdmin();
    }

    // Social personas — BOD can read/write; members can read for display
    match /socialPersonas/{platform} {
      allow read: if isActiveMember();
      allow write: if isBoard();
    }

    // Default: deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
