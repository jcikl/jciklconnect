# =============================================================================
# JCI KL Connect — Environment Variables Reference
# Copy this file to .env and fill in the values for local development.
# NEVER commit .env to git. Server-side secrets go in Netlify dashboard only.
# =============================================================================

# -----------------------------------------------------------------------------
# Firebase (client-side — required)
# Get from: Firebase Console → Project Settings → Your apps → Web app config
# -----------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=jci-lo-management-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=jci-lo-management-app
VITE_FIREBASE_STORAGE_BUCKET=jci-lo-management-app.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=212717402010
VITE_FIREBASE_APP_ID=1:212717402010:web:f8d6fd34154c8bab85ec23

# Firebase Cloud Messaging — VAPID public key for push notifications
# Get from: Firebase Console → Project Settings → Cloud Messaging → Web Push certificates
VITE_FIREBASE_VAPID_KEY=your_vapid_key_here

# Firebase App Check — reCAPTCHA v3 site key (production only; leave blank for dev)
# Get from: Google reCAPTCHA Admin Console → register site with reCAPTCHA v3
# Then enable App Check in Firebase Console → App Check → register web app
VITE_RECAPTCHA_SITE_KEY=

# -----------------------------------------------------------------------------
# Cloudinary (client-side — browser-safe vars only)
# Get from: Cloudinary Console → Settings → Upload
# -----------------------------------------------------------------------------
VITE_CLOUDINARY_CLOUD_NAME=drpa1zcmp
VITE_CLOUDINARY_UPLOAD_PRESET=jciklconnect
# Folder prefix for member avatars (falls back to VITE_CLOUDINARY_CLOUD_NAME if unset)
VITE_CLOUDINARY_MEMBER_AVATAR_ASSET_ROOT=jciklconnect
# SECURITY: CLOUDINARY_API_KEY and CLOUDINARY_API_SECRET must NOT use VITE_ prefix.
# Set them in the Netlify dashboard (server-side section below) — never here.

# -----------------------------------------------------------------------------
# WhatsApp API — inquiry notifications via whapi.cloud
# Get from: https://app.whapi.cloud → Channels → your channel → API token
# -----------------------------------------------------------------------------
VITE_WHAPI_TOKEN=your_whapi_token_here
VITE_WHAPI_ADMIN_PHONE=601XXXXXXXX

# -----------------------------------------------------------------------------
# App base URL — used by surveysService to generate shareable links
# In production this is set automatically by Netlify as the URL env var.
# -----------------------------------------------------------------------------
VITE_APP_BASE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Dev mock login (local dev only — never commit real values)
# Only active when import.meta.env.DEV is true (Vite dev server).
# -----------------------------------------------------------------------------
VITE_DEV_EMAIL=
VITE_DEV_PASSWORD=

# -----------------------------------------------------------------------------
# Accessibility — set to "true" to run axe-core scan in dev (logs to console)
# -----------------------------------------------------------------------------
# VITE_A11Y_SCAN=true


# =============================================================================
# SERVER-SIDE ONLY — Netlify dashboard env vars
# Set these in: Netlify → Site configuration → Environment variables
# NEVER add a VITE_ prefix to these; they must stay server-only.
# =============================================================================

# Firebase Admin SDK (used by all Netlify Functions)
# Get from: Firebase Console → Project Settings → Service accounts → Generate new private key
# FIREBASE_ADMIN_PROJECT_ID=jci-lo-management-app
# FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxx@jci-lo-management-app.iam.gserviceaccount.com
# FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Firebase Web API key (used by auto-invite and send-invite functions for REST sign-in)
# Same value as VITE_FIREBASE_API_KEY but without the VITE_ prefix for server use
# FIREBASE_WEB_API_KEY=your_firebase_web_api_key

# Cloudinary (server-side delete proxy — netlify/functions/cloudinary-delete.js)
# CLOUDINARY_CLOUD_NAME=drpa1zcmp
# CLOUDINARY_API_KEY=your_cloudinary_api_key
# CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# OpenAI (AI rewrite for social media posts — netlify/functions/social-ai-rewrite.mjs)
# Get from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...

# WhatsApp API token (server-side proxy — netlify/functions/whapi-proxy.js)
# Same token as VITE_WHAPI_TOKEN but kept server-side for security
# WHAPI_API_TOKEN=your_whapi_token_here

# ToyyibPay payment gateway
# Get from: https://toyyibpay.com → API settings
# TOYYIBPAY_SECRET_KEY=your_toyyibpay_sandbox_secret_key
# TOYYIBPAY_SECRET_KEY_PROD=your_toyyibpay_production_secret_key
# TOYYIBPAY_SANDBOX=true
# TOYYIBPAY_WEBHOOK_SECRET=your_random_webhook_shared_secret
# TOYYIBPAY_CALLBACK_URL=https://app.jcikl.cc/api/webhooks/toyyibpay

# Email sending (netlify/functions/send-email.js — uses first provider found)
# SendGrid: https://app.sendgrid.com → Settings → API keys
# SENDGRID_API_KEY=SG.xxxxx
# Resend: https://resend.com → API keys
# RESEND_API_KEY=re_xxxxx
# Mailgun: https://app.mailgun.com → Settings → API Keys
# MAILGUN_API_KEY=your_mailgun_api_key
# MAILGUN_DOMAIN=mg.yourdomain.com

# Zoom integration (create/cancel meetings)
# Get from: Zoom Marketplace → Build Server-to-Server OAuth app
# ZOOM_CLIENT_ID=your_zoom_client_id
# ZOOM_CLIENT_SECRET=your_zoom_client_secret
# ZOOM_ACCOUNT_ID=your_zoom_account_id
# ZOOM_HOST_USER_ID=your_zoom_host_user_email_or_id

# Lark Base sync (netlify/functions/lark-sync.mjs)
# LARK_API_ORIGIN=https://open.larksuite.com
# LARK_APP_ID=your_lark_app_id
# LARK_APP_SECRET=your_lark_app_secret
# LARK_BASE_TOKEN=your_lark_base_token
# LARK_MEMBERS_TABLE_ID=your_members_table_id

# Cron job authentication (birthday-notifications function)
# A random secret string — include in cron request header for validation
# CRON_SECRET=your_random_secret_string
